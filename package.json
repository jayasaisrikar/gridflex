{
  "name": "gridflex",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter './apps/*' dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @gridflex/web test:e2e",
    "db:generate": "pnpm --filter @gridflex/db drizzle-kit generate",
    "db:migrate": "pnpm --filter @gridflex/db drizzle-kit migrate",
    "db:check": "pnpm --filter @gridflex/db exec tsx scripts/check-schema.ts",
    "db:seed": "pnpm --filter @gridflex/db exec tsx scripts/seed.ts",
    "local:db:up": "docker compose -f docker-compose.local.yml up -d postgres",
    "local:db:down": "docker compose -f docker-compose.local.yml down",
    "build:packages": "pnpm -r --filter './packages/*' build",
    "predev": "pnpm build:packages",
    "dev:api": "pnpm --filter @gridflex/api dev",
    "dev:web": "pnpm --filter @gridflex/web dev",
    "db:seed:sim": "pnpm --filter @gridflex/db exec tsx scripts/seed-simulation.ts"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "tsx": "^4.19.2",
    "vitest": "^3.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "esbuild"
    ]
  }
}
