{
  "name": "gridflex",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter './apps/*' dev",
    "build": "pnpm build:packages && pnpm build:apps",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --dir apps/web run test:e2e",
    "db:generate": "pnpm --dir packages/db run db:generate",
    "db:migrate": "pnpm --dir packages/db run db:migrate",
    "db:check": "pnpm --filter @gridflex/db exec tsx scripts/check-schema.ts",
    "db:seed": "pnpm --filter @gridflex/db exec tsx scripts/seed.ts",
    "local:db:up": "docker compose -f docker-compose.local.yml up -d postgres",
    "local:db:down": "docker compose -f docker-compose.local.yml down",
    "build:packages": "pnpm --filter @gridflex/config build && pnpm --filter @gridflex/engine build && pnpm --filter @gridflex/forecast build && pnpm --filter @gridflex/contracts build && pnpm --filter @gridflex/db build",
    "build:apps": "pnpm --filter @gridflex/api build:app && pnpm --filter @gridflex/worker build:app && pnpm --filter @gridflex/web build:app",
    "build:api": "pnpm build:packages && pnpm --filter @gridflex/api build:app",
    "build:worker": "pnpm build:packages && pnpm --filter @gridflex/worker build:app",
    "build:web": "pnpm build:packages && pnpm --filter @gridflex/web build:app",
    "predev": "pnpm build:packages",
    "dev:api": "pnpm --filter @gridflex/api dev",
    "dev:web": "pnpm --filter @gridflex/web dev",
    "db:seed:sim": "pnpm --filter @gridflex/db exec tsx scripts/seed-simulation.ts",
    "telemetry:poll": "pnpm --filter @gridflex/db exec tsx scripts/telemetry-poller.ts",
    "telemetry:topup": "pnpm --filter @gridflex/db exec tsx scripts/telemetry-poller.ts --once",
    "passport:issue": "pnpm --filter @gridflex/db exec tsx scripts/issue-passport.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "typescript-eslint": "^8.20.0",
    "typescript": "^5.7.3",
    "tsx": "^4.19.2",
    "vitest": "^3.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "esbuild"
    ]
  }
}
