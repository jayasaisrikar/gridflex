# GridFlex local development environment.
# Copy to .env and fill in. NEVER put production credentials in a committed file.
# The live Coolify values live only in GridFlex_private.env (git-ignored) and in
# Coolify environment variables.

APP_ENV=development
LOG_LEVEL=debug

# --- Database ---
# Local development default (docker-compose.local.yml).
DATABASE_URL=postgresql://gridflex:gridflex@localhost:5433/gridflex

# --- API ---
API_PORT=4000

# --- Auth ---
# Generate with: openssl rand -base64 48
AUTH_SECRET=replace-me-with-a-48-byte-random-value
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- Connector credential encryption ---
# MUST be distinct from AUTH_SECRET. Generate with: openssl rand -base64 32
CONNECTOR_ENCRYPTION_KEY=replace-me-with-a-32-byte-random-value

# --- Storage ---
STORAGE_ROOT=./.data/gridflex

# --- Worker ---
WORKER_INSTANCE_ID=worker-local
WORKER_TELEMETRY_STALE_MINUTES=15
WORKER_ENVELOPE_VALIDITY_MINUTES=75
# Set only for a one-shot deployment smoke; scheduled workers leave this false.
WORKER_RUN_ONCE=false

# --- Web ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
API_INTERNAL_BASE_URL=http://127.0.0.1:4000/api/v1

# --- Agent harness (optional) ---
# Configure to enable live model-driven sessions (POST /facilities/:id/agent/run).
# Unset = live sessions disabled; the console and deterministic path still work.
# OpenAI-compatible chat-completions endpoint (OpenRouter, OpenAI, vLLM, Ollama).
AGENT_MODEL_BASE_URL=
AGENT_MODEL_API_KEY=
AGENT_MODEL_ID=
