# GridFlex local development environment.
# Copy to .env and fill in. NEVER put production credentials in a committed file.
# The live Coolify values live only in GridFlex_private.env (git-ignored) and in
# Coolify environment variables.

APP_ENV=development
LOG_LEVEL=debug

# --- Database ---
# Local development default (docker-compose.local.yml).
DATABASE_URL=postgresql://gridflex:gridflex@localhost:5433/gridflex

# --- API ---
API_PORT=4000

# --- Auth ---
# Generate with: openssl rand -base64 48
AUTH_SECRET=replace-me-with-a-48-byte-random-value
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- Connector credential encryption ---
# MUST be distinct from AUTH_SECRET. Generate with: openssl rand -base64 32
CONNECTOR_ENCRYPTION_KEY=replace-me-with-a-32-byte-random-value

# --- Storage ---
STORAGE_ROOT=./.data/gridflex

# --- Web ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
API_INTERNAL_BASE_URL=http://localhost:4000/api/v1
