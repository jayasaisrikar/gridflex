# Copy to infra/runtime/pilot.env. Never use production credentials locally.
POSTGRES_USER=gridflex
POSTGRES_PASSWORD=replace-with-a-long-local-password
POSTGRES_DB=gridflex
AUTH_SECRET=replace-with-at-least-32-random-characters
CONNECTOR_ENCRYPTION_KEY=replace-with-a-different-32-character-secret
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
WORKER_INSTANCE_ID=pilot-worker-1
